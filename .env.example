# Development requires no secrets: npm run dev
# Production only; enter real secrets in the hosting provider's settings.
# Never commit an actual .env file. npm scripts do not load .env automatically.
APP_ORIGIN=https://your-app.example.com
DATABASE_PATH=/var/data/haru.sqlite
PORT=3000
TRUST_PROXY_HOPS=1
MAIL_FROM=Haru <hello@your-verified-domain.example>
# Set RESEND_API_KEY securely in hosting settings; no value belongs here.
# Optional: BACKUP_DIRECTORY=/var/data/backups
